# Copy this file to <customer-slug>.env (e.g. hussein.env) and fill it in
# BEFORE issuing that customer's first build. Keep it forever, even after
# they're up and running — it's your record of exactly what their build
# used, so a bugfix rebuild months from now doesn't rely on memory.
#
# To build for this customer:
#   cp customers/hussein.env .env && npm run electron:build
#
# Do NOT put the license key in this file — that's not a build input, it's
# generated separately (vendor-tools/keygen.mjs) and lives permanently in
# your vendor Supabase project's `licenses` table, not on disk anywhere.

VITE_BUSINESS_NAME=Their Business Name
VITE_ACTIVATION_ENDPOINT=https://cgmsdpxwyryavqmetmmw.functions.supabase.co/activate-license

# Leave unset unless/until this specific customer has separately paid for
# the (not yet available) cloud-backup add-on:
# VITE_UPDATE_URL=
