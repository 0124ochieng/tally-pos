# --- Set per install, whenever this build is restructured for a new
# business (browser tab title, PWA name, sidebar/login heading, receipts,
# and exported file names all read this) ---
VITE_BUSINESS_NAME=My Shop

# --- Local development ---
# Skips the license activation gate entirely so `npm run dev` works without
# a real license key or vendor server. Never set this in a customer build.
VITE_SKIP_ACTIVATION=true

# Fallback Supabase credentials used only when VITE_SKIP_ACTIVATION is true
# (or in a build where activation hasn't run yet). In a real customer
# install, credentials instead come from license activation — see
# src/lib/license.ts and vendor-supabase/activate-license.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Customer builds only (leave unset for local dev) ---
# URL of your deployed vendor Supabase Edge Function that validates license
# keys and issues activation certificates. See vendor-supabase/activate-license.
VITE_ACTIVATION_ENDPOINT=
